# One ignore file for the whole repo. Course-specific rules are scoped to their
# folder so that, for example, the C course ignoring *.txt does not hide the
# input files that the system software lab needs.

# macOS, editors, tooling
.DS_Store
.idea/
*.iml
.vscode/
.claude/

# C and C++ build output (the Makefiles build into bin/)
a.out
*.o
*.out
*.exe
bin/

# Java
*.class
*.jar

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
venv/
.venv/

# Node
node_modules/
npm-debug.log

# HDL simulation output (GHDL, Icarus Verilog)
*.vvp
*.vcd
*.ghw
work-obj*.cf
e~*

# Terraform, Vagrant, local secrets
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
.vagrant/
.env
*.pem
*.der

# saved models (figures are committed, models are not)
*.pkl
*.joblib
*.h5

# logs and scratch files
*.log
*.tmp

